{% schema %}
{
  "name": "Shop by Occasion",
  "settings": [
    {
      "type": "header",
      "content": "Main Section"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Occasion"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Thoughtful gifts for all occasions!"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "header",
      "content": "Gift Categories"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "First Category Image"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "First Category Title",
      "default": "Anniversary Gifts"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "First Category Link"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second Category Image"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Second Category Title",
      "default": "Birthday Gifts"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Second Category Link"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Third Category Image"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Third Category Title",
      "default": "Most Gifted"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Third Category Link"
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<div class="occasion-section">
  <div class="main-content">
    {% if section.settings.main_image %}
      <img src="{{ section.settings.main_image | img_url: 'large' }}" alt="Gifts" class="main-image">
    {% endif %}
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.subtitle }}</p>
  </div>
  <div class="gift-categories">
    {% for i in (1..3) %}
      <div class="gift-category">
        {% assign image_id = 'image_' | append: i %}
        {% assign title_id = 'title_' | append: i %}
        {% assign link_id = 'link_' | append: i %}
        {% if section.settings[image_id] %}
          <a href="{{ section.settings[link_id] }}">
            <img src="{{ section.settings[image_id] | img_url: 'medium' }}" alt="{{ section.settings[title_id] }}">
            <div class="gift-title">{{ section.settings[title_id] }}</div>
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

