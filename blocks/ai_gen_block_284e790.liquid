{% doc %}
  @prompt
    <div class="btn-container">
      <a href="https://example.com/page1" class="btn">Button 1</a>
      <a href="https://example.com/page2" class="btn">Button 2</a>
    </div>
    
    <style>
    .btn-container {
      display: flex;
      justify-content: center; /* Center align */
      gap: 20px; /* space between buttons */
      margin: 20px 0;
    }
    
    .btn {
      background-color: #333; /* button color */
      color: white;
      padding: 12px 25px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      transition: 0.3s;
    }
    
    .btn:hover {
      background-color: #555;
    }
    </style>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-button-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.button_gap }}px;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
    flex-wrap: wrap;
  }

  .ai-dual-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    min-width: {{ block.settings.button_min_width }}px;
  }

  .ai-dual-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-dual-button-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_background_color }};
    outline-offset: 2px;
  }

  .ai-dual-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_2_background_color }};
    color: {{ block.settings.button_2_text_color }};
    border-color: {{ block.settings.button_2_border_color }};
  }

  .ai-dual-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_2_hover_background_color }};
    color: {{ block.settings.button_2_hover_text_color }};
    border-color: {{ block.settings.button_2_hover_border_color }};
  }

  .ai-dual-button-secondary-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.button_2_background_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-button-container-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        flex-direction: column;
        align-items: {{ block.settings.mobile_alignment }};
      {% endif %}
      gap: {{ block.settings.mobile_button_gap }}px;
    }

    .ai-dual-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        width: 100%;
        max-width: {{ block.settings.mobile_max_width }}px;
      {% endif %}
      font-size: {{ block.settings.mobile_font_size }}px;
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }
  }
{% endstyle %}

<div class="ai-dual-button-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.button_1_text != blank %}
    <a 
      href="{{ block.settings.button_1_link }}" 
      class="ai-dual-button-{{ ai_gen_id }}"
      {% if block.settings.button_1_link == blank %}aria-disabled="true"{% endif %}
    >
      {{ block.settings.button_1_text }}
    </a>
  {% endif %}

  {% if block.settings.button_2_text != blank %}
    <a 
      href="{{ block.settings.button_2_link }}" 
      class="ai-dual-button-{{ ai_gen_id }} ai-dual-button-secondary-{{ ai_gen_id }}"
      {% if block.settings.button_2_link == blank %}aria-disabled="true"{% endif %}
    >
      {{ block.settings.button_2_text }}
    </a>
  {% endif %}
</div>

